{
  "schemaVersion": 1,
  "checkpointId": "0.CP",
  "checkpointName": "Repository Governance + Platform Boundary + Contract-Drift Protection Ready",
  "contractSuiteVersion": "1.0.7",
  "requiredWorkflowSteps": [
    {
      "name": "Install dependencies without lifecycle scripts",
      "run": "pnpm install --frozen-lockfile --ignore-scripts"
    },
    {
      "name": "Verify exact toolchain",
      "run": "pnpm toolchain:verify"
    },
    {
      "name": "Format hygiene",
      "run": "pnpm format:check"
    },
    {
      "name": "Schema integrity",
      "run": "pnpm schema:check"
    },
    {
      "name": "Generated contract artifacts",
      "run": "pnpm contract:check-generated"
    },
    {
      "name": "Contract manifest",
      "run": "pnpm contract:check-manifest"
    },
    {
      "name": "Contract and profile drift",
      "run": "pnpm contract:check-drift"
    },
    {
      "name": "Repository governance",
      "run": "pnpm governance:check"
    },
    {
      "name": "Secret scan",
      "run": "pnpm security:secrets"
    },
    {
      "name": "Dependency inventory",
      "run": "pnpm dependency:check"
    },
    {
      "name": "License and provenance",
      "run": "pnpm provenance:check"
    },
    {
      "name": "TypeScript strict typecheck",
      "run": "pnpm typecheck"
    },
    {
      "name": "TypeScript build",
      "run": "pnpm build"
    },
    {
      "name": "Core build",
      "run": "pnpm build:core"
    },
    {
      "name": "Desktop UI build",
      "run": "pnpm build:ui"
    },
    {
      "name": "Architecture enforcement",
      "run": "pnpm architecture:check"
    },
    {
      "name": "Normal deterministic tests",
      "run": "pnpm test"
    },
    {
      "name": "Node dependency vulnerability gate",
      "run": "pnpm audit --audit-level high"
    },
    {
      "name": "Rust dependency vulnerability audit",
      "run": "cargo audit --file Cargo.lock --target-os windows --target-arch x86_64"
    },
    {
      "name": "Rust formatting",
      "run": "cargo fmt --all -- --check"
    },
    {
      "name": "Rust clippy warnings-as-errors",
      "run": "cargo clippy --locked --workspace --all-targets --all-features -- -D warnings"
    },
    {
      "name": "Rust host build",
      "run": "cargo check --locked --workspace --all-targets --all-features"
    },
    {
      "name": "Rust Windows-target build",
      "run": "cargo check --locked --workspace --target x86_64-pc-windows-msvc"
    }
  ],
  "requiredEvidencePaths": [
    "docs/implementation/evidence/0.1-implementation-admission.md",
    "docs/implementation/evidence/0.2-monorepo-boundaries.md",
    "docs/implementation/evidence/0.3-platform-runtime-identity.md",
    "docs/implementation/evidence/0.4-platform-capability-contracts.md",
    "docs/implementation/evidence/0.5-platform-composition-root.md",
    "docs/implementation/evidence/0.6-protocol-schema-foundation.md",
    "docs/implementation/evidence/0.7-canonical-contract-values.md",
    "docs/implementation/evidence/0.8-pinned-toolchain-baseline.md",
    "docs/implementation/evidence/0.9-test-layer-architecture.md",
    "docs/implementation/evidence/0.10-architecture-enforcement.md",
    "docs/implementation/evidence/0.11-static-ci-baseline.md",
    "docs/implementation/evidence/0.12-contract-reproducibility-and-drift.md",
    "docs/implementation/evidence/0.13-master-protection-blocker.md"
  ],
  "forbiddenActivePaths": [
    "docs/JARVIS-CONTRACT-MANIFEST-v1.0.5.md",
    "docs/JARVIS-IMPLEMENTATION-CONTRACT-v1.0.5.md"
  ]
}
