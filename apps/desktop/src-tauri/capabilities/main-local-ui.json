{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local-ui",
  "description": "The bundled JARVIS renderer has only the narrowly scoped HTTP(S) external-link opener permission.",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
